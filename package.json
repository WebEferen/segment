{
  "name": "segment-state",
  "version": "0.0.1",
  "description": "Framework-agnostic, path-addressed state with O(observed) memory and transactional commits.",
  "keywords": [
    "state-management",
    "state",
    "store",
    "typescript",
    "fine-grained-reactivity",
    "octane"
  ],
  "author": {
    "name": "Michal Makowski",
    "email": "michal@moxxy.ai"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebEferen/segment.git"
  },
  "bugs": {
    "url": "https://github.com/WebEferen/segment/issues"
  },
  "homepage": "https://webeferen.github.io/segment/",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./octane": {
      "types": "./dist/octane/index.d.ts",
      "import": "./dist/octane/index.js",
      "default": "./dist/octane/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p typetests/tsconfig.json",
    "test": "vitest run",
    "test:core": "vitest run --project segment-core",
    "test:octane": "vitest run --project segment-octane",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agents:generate": "rulesync generate",
    "agents:check": "rulesync doctor --strict && rulesync generate --check",
    "changeset": "changeset",
    "changeset:check": "changeset status --since",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "vitepress preview docs",
    "playground": "pnpm build && pnpm --dir playground dev",
    "playground:build": "pnpm build && pnpm --dir playground build",
    "benchmark:build": "node benchmarks/segment-state/build.mjs",
    "benchmark": "pnpm benchmark:build && node --expose-gc --import tsx benchmarks/segment-state/run.mjs",
    "benchmark:hot": "pnpm benchmark:build && node benchmarks/segment-state/hot.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "pnpm format:check && pnpm agents:check && pnpm typecheck && pnpm test && pnpm build && pnpm playground:build && pnpm docs:build",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check && pnpm pack:check"
  },
  "peerDependencies": {
    "octane": "^0.1.21"
  },
  "peerDependenciesMeta": {
    "octane": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@tsrx/prettier-plugin": "0.3.118",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "jotai": "2.20.2",
    "jsdom": "29.1.1",
    "octane": "0.1.21",
    "prettier": "3.9.6",
    "redux": "5.0.1",
    "rulesync": "16.3.0",
    "terser": "5.49.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "valtio": "2.3.2",
    "vite": "8.1.5",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "zustand": "5.0.14"
  }
}
